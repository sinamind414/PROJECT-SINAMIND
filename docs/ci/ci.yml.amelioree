name: CI/CD Khawarizmi Pro

on:
  push:
    branches: [main, fabuleux/*, arena/*]
  pull_request:
    branches: [main]

jobs:
  backend-tests:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          cd khawarizmi-backend
          pip install -r requirements.txt
          pip install ruff

      - name: Lint (ruff — bloquant)
        run: |
          cd khawarizmi-backend
          ruff check .

      - name: Import smoke (app boote)
        run: |
          cd khawarizmi-backend
          SECRET_KEY=ci-test-key-for-smoke-tests-only \
          ENVIRONMENT=ci \
          DATABASE_URL=postgresql+asyncpg://x:x@localhost/x \
          REDIS_URL= python -c "
          from main import app
          n = len([r for r in app.routes if getattr(r, 'path', '').startswith('/api')])
          print(f'App OK — {n} routes API')
          assert n > 100
          "

      - name: Full test suite (633 tests, preview SQLite)
        run: |
          cd khawarizmi-backend
          SECRET_KEY=ci-test-key-for-smoke-tests-only \
          ENVIRONMENT=ci \
          DATABASE_URL=sqlite+aiosqlite:///./ci_test.db \
          REDIS_URL=redis://localhost:6379/9 \
          python -m pytest tests/ -q --no-header

      - name: Golden set (local, 0 token — BLOQUANT)
        run: |
          cd khawarizmi-backend
          python tests/golden/build_golden_annotated.py
          SECRET_KEY=ci-test-key-for-smoke-tests-only \
          ENVIRONMENT=ci \
          DATABASE_URL=sqlite+aiosqlite:///./ci_test.db \
          REDIS_URL=redis://localhost:6379/9 \
          python -m pytest tests/golden/test_golden_local.py -v --tb=short
        # Seuils : L2 MAE ≤ 0.85 · severe ≤ 0.10 · κ ≥ 0.45
        #          savoir MAE ≤ 0.35 · severe == 0.0 (spécialiste, conf ≥ 0.92)

  frontend-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"
          cache-dependency-path: khawarizmi-frontend/package-lock.json

      - name: Install dependencies
        run: npm ci
        working-directory: khawarizmi-frontend

      - name: Lint (bloquant)
        run: npm run lint
        working-directory: khawarizmi-frontend

      - name: Tests
        run: npm run test
        working-directory: khawarizmi-frontend

      - name: Build (hermétique, sans Google Fonts)
        run: npm run build
        working-directory: khawarizmi-frontend
        env:
          NEXT_TELEMETRY_DISABLED: "1"

  golden-llm-nightly:
    if: github.event_name == 'schedule'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          cd khawarizmi-backend
          pip install -r requirements.txt

      - name: Golden set (LLM, nightly — qualité JSON natif)
        run: |
          cd khawarizmi-backend
          SECRET_KEY=ci-test-key-for-smoke-tests-only \
          ENVIRONMENT=ci \
          ENABLE_EXTERNAL_LLM=1 \
          OPENAI_API_KEY=${{ secrets.OPENAI_API_KEY }} \
          DATABASE_URL=sqlite+aiosqlite:///./ci_test.db \
          REDIS_URL=redis://localhost:6379/9 \
          python -m pytest tests/golden/test_json_mode_quality.py -m nightly -v --tb=short
        # Seuils : MAE(json, libre) ≤ 0.15 · std(json) ≥ 0.70×std(libre)

  deploy-railway:
    if: github.ref == 'refs/heads/main'
    needs: [backend-tests, frontend-tests]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Railway CLI
        run: npm install -g @railway/cli

      - name: Deploy to Railway
        run: railway up --detach --service PROJECT-SINAMIND --environment production
        working-directory: khawarizmi-backend
        env:
          RAILWAY_TOKEN: ${{ secrets.RAILWAY_TOKEN }}
